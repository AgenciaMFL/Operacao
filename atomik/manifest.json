{
  "manifest_version": 3,
  "name": "Atomik",
  "short_name": "Atomik",
  "version": "1.0.0",
  "description": "Kit de produtividade para Elementor: Figma → Elementor, Código → Elementor, seções, componentes, estilos, copy, animações e automações.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Abrir Atomik", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs", "clipboardWrite", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+A" }, "description": "Abrir o Atomik" }
  }
}

# Sentry — error monitoring (optional, leave blank to disable).
# Frontend uses the VITE_ variable (baked at build time — needs a Publish).
# Edge Functions use SENTRY_DSN configured in Project Settings → Secrets.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

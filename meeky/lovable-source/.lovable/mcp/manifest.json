{
  "version": 1,
  "sdk_version": "0.22.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://abmbodewtnldwvgqwbno.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "meeky-mcp",
      "version": "0.1.0",
      "title": "Meeky MCP"
    },
    "tools": [
      {
        "name": "get_product_info",
        "title": "Get product info",
        "description": "Return static information about the Meeky F5 ANC Pro headphone: SKU, price, key specs, and canonical URL.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_orders",
        "title": "List recent orders",
        "description": "List the most recent orders. Row visibility is enforced by database RLS — only admins see data.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "status": {
              "description": "Filter by payment_status (approved, pending, rejected, cancelled).",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_order",
        "title": "Get order by ID",
        "description": "Fetch a single order with shipping details. Row visibility is enforced by database RLS.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Order UUID."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_active_coupons",
        "title": "List active coupons",
        "description": "List currently active coupons. Row visibility is enforced by database RLS.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_leads",
        "title": "List B2B / VIP leads",
        "description": "List recent leads. Row visibility is enforced by database RLS.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "b2b",
                "vip"
              ],
              "description": "Which lead table to read from."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "source"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}

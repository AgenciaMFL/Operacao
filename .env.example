# Copie para .env (não vai para o git) e preencha.
WP_URL=https://www.seusite.com.br
WP_USER=usuario-wordpress
# Usuários > Perfil > Senhas de aplicativo (pode colar com os espaços)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# ID da página do encarte (aparece na URL do editor: post.php?post=123). Várias: 123,456
WP_PAGE_IDS=123

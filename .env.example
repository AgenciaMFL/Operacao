# Copie para .env e preencha. O .env NÃO vai para o git.

# Chave da API do Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Transcrição: tiny | base | small | medium | large-v3  (large-v3 = melhor, precisa de GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
LANGUAGE=pt

# Seleção dos cortes
CLAUDE_MODEL=claude-opus-5-5
MAX_CLIPS=6
MIN_CLIP_SECONDS=20
MAX_CLIP_SECONDS=59
# Ajuda o Claude a escolher melhor: nicho, público, tom do canal
CHANNEL_CONTEXT=

# Vídeo: face (segue o rosto) | center | blur (vídeo inteiro com fundo desfocado)
REFRAME_MODE=face
SUBTITLE_FONT=DejaVu Sans
# Cor da palavra destacada em BGR (formato ASS): 00FFFF=amarelo, 00FF00=verde, FFFF00=ciano
SUBTITLE_HIGHLIGHT=00FFFF
WORDS_PER_CAPTION=3

# YouTube
# private | unlisted | public  (comece com private para revisar)
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=22
YOUTUBE_EXTRA_TAGS=
# >0 agenda um Short a cada N horas em vez de soltar todos de uma vez
HOURS_BETWEEN_POSTS=0

CORTES_WORK_DIR=work
CORTES_SECRETS_DIR=secrets
